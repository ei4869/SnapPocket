<Window x:Class="SnapPocket.UI.Capture.ScrollingRegionFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">
    <Border x:Name="RegionBorder"
            BorderBrush="#FF4C9AFF"
            BorderThickness="3"
            Background="Transparent"
            SnapsToDevicePixels="True" />
</Window>
