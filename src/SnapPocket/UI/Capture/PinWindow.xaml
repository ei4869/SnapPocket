<Window x:Class="SnapPocket.UI.Capture.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyDown="OnKeyDown"
        PreviewMouseWheel="OnMouseWheel"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">
    <!-- Lightweight dual-ring frame (zero CPU DropShadowEffect blur overhead during 120Hz resize) -->
    <Border Margin="2"
            BorderBrush="#55000000"
            BorderThickness="1"
            CornerRadius="3"
            Background="Transparent">
        <Border x:Name="FrameBorder"
                BorderBrush="#884C9AFF"
                BorderThickness="1.5"
                CornerRadius="2"
                Background="#FF101217">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="保存到来源应用目录" Click="SaveMenuItem_Click" />
                    <MenuItem Header="复制到剪贴板" Click="CopyMenuItem_Click" />
                    <MenuItem Header="打开快速标注..." Click="AnnotateMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="缩放比例">
                        <MenuItem Header="50%" Tag="0.5" Click="PresetZoomMenuItem_Click" />
                        <MenuItem Header="75%" Tag="0.75" Click="PresetZoomMenuItem_Click" />
                        <MenuItem Header="100% (原始尺寸)" Tag="1.0" Click="PresetZoomMenuItem_Click" />
                        <MenuItem Header="150%" Tag="1.5" Click="PresetZoomMenuItem_Click" />
                        <MenuItem Header="200%" Tag="2.0" Click="PresetZoomMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="重置不透明度 (100%)" Click="ResetOpacityMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="关闭贴图 (Esc)" Click="CloseMenuItem_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid x:Name="ContentGrid"
                  Background="Transparent"
                  MouseLeftButtonDown="ContentGrid_MouseDown"
                  MouseMove="ContentGrid_MouseMove"
                  MouseLeftButtonUp="ContentGrid_MouseUp">
                <Image x:Name="PinImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Corner proportional resize grip indicators (visible on hover) -->
                <Grid x:Name="CornerGripsLayer" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border Width="9" Height="9" CornerRadius="2" Background="#FFFFFFFF" BorderBrush="#FF4C9AFF" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0" />
                    <Border Width="9" Height="9" CornerRadius="2" Background="#FFFFFFFF" BorderBrush="#FF4C9AFF" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" />
                    <Border Width="9" Height="9" CornerRadius="2" Background="#FFFFFFFF" BorderBrush="#FF4C9AFF" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1" />
                    <Border Width="9" Height="9" CornerRadius="2" Background="#FFFFFFFF" BorderBrush="#FF4C9AFF" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                </Grid>

                <Border x:Name="ScaleHud"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Padding="7,3"
                        CornerRadius="4"
                        Background="#DD14171F"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="ScaleHudText"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="White" />
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
