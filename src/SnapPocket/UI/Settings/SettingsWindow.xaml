<Window x:Class="SnapPocket.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapPocket - 详细设置"
        Width="860"
        Height="600"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsNav" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Margin="-6,0,0,0"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource AccentBrush}" />
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="206" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Padding="14,18"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,20">
                    <TextBlock Text="SnapPocket"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="智能目录截屏工具"
                               Margin="0,2,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavGeneral" Content="常规与悬浮窗" Style="{StaticResource NavTabStyle}" IsChecked="True" Tag="General" Click="NavTab_Click" />
                    <RadioButton x:Name="NavHotkeys" Content="快捷键" Style="{StaticResource NavTabStyle}" Tag="Hotkeys" Click="NavTab_Click" />
                    <RadioButton x:Name="NavDirectories" Content="应用目录记忆" Style="{StaticResource NavTabStyle}" Tag="Directories" Click="NavTab_Click" />
                    <RadioButton x:Name="NavCaptureSave" Content="截图与保存" Style="{StaticResource NavTabStyle}" Tag="CaptureSave" Click="NavTab_Click" />
                    <RadioButton x:Name="NavAppearance" Content="外观与关于" Style="{StaticResource NavTabStyle}" Tag="Appearance" Click="NavTab_Click" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           VerticalAlignment="Bottom"
                           Margin="6,0,6,4"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="v1.0.0 · 便携原生版" />
            </DockPanel>
        </Border>

        <!-- Right Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid>
                <!-- Page 1: General & Dock -->
                <StackPanel x:Name="PageGeneral" Visibility="Visible">
                    <TextBlock Text="常规与悬浮窗" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="StartupCheckBox"
                                      Content="开机自动启动 SnapPocket"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Click="StartupCheckBox_Click" />
                            <TextBlock Text="仅写入当前用户启动项，无需管理员权限"
                                       Margin="0,4,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="贴边悬浮工具" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <CheckBox x:Name="DockCompleteHideCheckBox"
                                      Content="闲置时完全隐藏（屏幕边缘不留痕迹，鼠标靠近即唤出）"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Margin="0,0,0,12"
                                      Click="DockCompleteHideCheckBox_Click" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="贴靠屏幕边缘" FontSize="13" />
                                    <TextBlock Text="可在边缘上下拖动把手调整高度" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="DockEdgeCombo" Grid.Column="1" Width="130" VerticalAlignment="Center" SelectionChanged="DockEdgeCombo_SelectionChanged">
                                    <ComboBoxItem Content="右侧边缘" Tag="Right" />
                                    <ComboBoxItem Content="左侧边缘" Tag="Left" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="边缘靠近触发灵敏度" FontSize="13" />
                                    <TextBlock Text="鼠标距离屏幕边缘多少像素时滑出把手" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Slider x:Name="TriggerPxSlider" Grid.Column="1" Minimum="4" Maximum="28" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="DockSliders_ValueChanged" />
                                <TextBlock x:Name="TriggerPxText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="自动隐藏延时" FontSize="13" />
                                    <TextBlock Text="鼠标离开贴边工具后多久自动缩回" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Slider x:Name="AutoHideDelaySlider" Grid.Column="1" Minimum="250" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="DockSliders_ValueChanged" />
                                <TextBlock x:Name="AutoHideDelayText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="通知与反馈" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <CheckBox x:Name="ToastCheckBox"
                                      Content="保存完成后在右下角显示轻量提示（不抢游戏焦点）"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Margin="0,0,0,10"
                                      Click="NotificationToggles_Click" />
                            <CheckBox x:Name="SoundCheckBox"
                                      Content="截屏保存成功时播放系统轻提示音"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Click="NotificationToggles_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 2: Hotkeys -->
                <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="快捷键" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="点击按键输入框，再按下要使用的组合键。"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="恢复默认键位"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="ResetHotkeys_Click" />
                    </Grid>

                    <Border x:Name="HotkeyErrorBanner"
                            Visibility="Collapsed"
                            Margin="0,0,0,12"
                            Padding="12,9"
                            CornerRadius="8"
                            Background="#33EF5350"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="HotkeyErrorBannerText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Padding="14,10">
                        <StackPanel>
                            <CheckBox x:Name="LaunchShortcutCheckBox"
                                      Content="退出后快捷启动"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Click="LaunchShortcutCheckBox_Click" />
                            <TextBlock x:Name="LaunchShortcutHint"
                                       Margin="0,4,0,0"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="LaunchShortcutStatus"
                                       Margin="0,5,0,0"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Padding="14,10">
                        <StackPanel x:Name="HotkeysContainer" />
                    </Border>
                </StackPanel>

                <!-- Page 3: App Directory Memory -->
                <StackPanel x:Name="PageDirectories" Visibility="Collapsed">
                    <TextBlock Text="应用目录记忆" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="全局默认保存目录" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="桌面、多窗口或未单独绑定目录的应用/游戏将自动保存到此目录"
                                       Margin="0,2,0,10"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DefaultDirBox"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="浏览修改..."
                                        Style="{StaticResource AccentButtonStyle}"
                                        Margin="0,0,6,0"
                                        Click="ChangeDefaultDir_Click" />
                                <Button Grid.Column="2"
                                        Content="打开"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Click="OpenDefaultDir_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="已记忆的应用 / 游戏目录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBox x:Name="RuleSearchBox"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Margin="0,0,8,0"
                                         ToolTip="按进程名或目录路径筛选"
                                         TextChanged="RuleSearchBox_TextChanged" />
                                <Button Grid.Column="2"
                                        Content="清空全部"
                                        Style="{StaticResource DangerSubtleButtonStyle}"
                                        Click="ClearAllRules_Click" />
                            </Grid>

                            <TextBlock x:Name="EmptyRulesHint"
                                       Text="暂无已记忆的应用规则。在任意应用或游戏中使用贴边悬浮面板切换保存目录后，规则会自动出现在此处。"
                                       Margin="0,12,0,8"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <StackPanel x:Name="RulesListPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 4: Capture & Save Settings -->
                <StackPanel x:Name="PageCaptureSave" Visibility="Collapsed">
                    <TextBlock Text="截图与保存" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="截屏后流转开关（与悬浮面板实时同步）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <CheckBox x:Name="SettingsAnnotationToggle"
                                      Content="截屏后进入矢量快速标注模式"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Margin="0,0,0,10"
                                      Click="CaptureFlowToggles_Click" />
                            <CheckBox x:Name="SettingsRenameToggle"
                                      Content="截屏确认保存前在屏幕上方弹出自定义命名框"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Click="CaptureFlowToggles_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="多显示器与画质" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="全屏截图默认范围" FontSize="13" />
                                    <TextBlock Text="单屏或多屏环境下按下全屏快捷键时截取的范围" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="FullscreenScopeCombo" Grid.Column="1" Width="195" VerticalAlignment="Center" SelectionChanged="CaptureFormat_Changed">
                                    <ComboBoxItem Content="当前鼠标/活动窗口所在显示器" Tag="CurrentMonitor" />
                                    <ComboBoxItem Content="全部显示器拼接整屏" Tag="AllMonitors" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="默认图片保存格式" FontSize="13" />
                                    <TextBlock Text="PNG 无损最清晰；JPG / WebP 体积更小" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="FormatCombo" Grid.Column="1" Width="195" VerticalAlignment="Center" SelectionChanged="CaptureFormat_Changed">
                                    <ComboBoxItem Content="PNG (无损推荐)" Tag="Png" />
                                    <ComboBoxItem Content="JPG (高压缩)" Tag="Jpg" />
                                    <ComboBoxItem Content="WebP (现代高效)" Tag="WebP" />
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="QualityRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="JPG / WebP 压缩质量" FontSize="13" />
                                    <TextBlock Text="PNG 为无损格式，无需质量参数" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="50" Maximum="100" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="QualitySlider_ValueChanged" />
                                <TextBlock x:Name="QualityText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="自定义文件名模板" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="可用占位符：{app}（应用名/Desktop）、{mode}（截图模式）、{yyyyMMdd_HHmmss}、{yyyy}、{MM}、{dd}、{HH}、{mm}、{ss}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBox x:Name="TemplateBox"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextChanged="TemplateBox_TextChanged" />
                            <TextBlock x:Name="TemplatePreviewText"
                                       Margin="2,7,0,0"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 5: Appearance & About -->
                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                    <TextBlock Text="外观与关于" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="界面主题" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="支持自动跟随 Windows 系统深浅色设置" Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="150" VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="FollowSystem" />
                                <ComboBoxItem Content="深色模式" Tag="Dark" />
                                <ComboBoxItem Content="浅色模式" Tag="Light" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="配置文件与便携存储" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock x:Name="ConfigPathText"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="打开配置文件所在目录"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OpenConfigDir_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="关于 SnapPocket" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="原生 .NET 9 + WPF 构建 · 零注入兼容游戏反作弊 · 按应用自动记忆截图目录 · 矢量快速标注 · 贴图置顶与滚动长截图"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
